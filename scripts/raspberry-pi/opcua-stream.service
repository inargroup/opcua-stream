[Unit]
Description=OPC//STREAM OPC UA Sender/Receiver backend
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=__APP_USER__
SupplementaryGroups=dialout
WorkingDirectory=__APP_DIR__/backend
ExecStart=__APP_DIR__/backend/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
